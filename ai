        "%%writefile src/api.py\n",
        "from flask import Flask, request, jsonify\n",
        "import joblib\n",
        "import numpy as np\n",
        "from tensorflow.keras.models import load_model\n",
        "\n",
        "rf_model = joblib.load(\"models/threat_detector_rf.pkl\")\n",
        "dl_model = load_model(\"models/threat_detector_dl.h5\")\n",
        "\n",
        "app = Flask(__name__)\n",
        "\n",
        "@app.route(\"/predict\", methods=[\"POST\"])\n",
        "def predict():\n",
        "    data = np.array(request.json[\"features\"]).reshape(1, -1)\n",
        "    rf_pred = rf_model.predict(data)[0]\n",
        "    dl_probs = dl_model.predict(data)\n",
        "    dl_pred = int(np.argmax(dl_probs))\n",
        "\n",
        "    return jsonify({\n",
        "        \"rf_prediction\": str(rf_pred),\n",
        "        \"dl_prediction\": str(dl_pred),\n",
        "        \"dl_confidence\": float(dl_probs.max())\n",
        "    })\n",
        "\n",
        "app.run(host=\"0.0.0.0\", port=5000)\n"
